# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the documented template, which carries placeholders only.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Client source material: the company profile PDF (certificate scans, executive
# CVs, vendor numbers) and the raw photo sets it came with. 66MB of binaries,
# and business-sensitive — git history would keep them permanently. The content
# extracted from them lives in src/messages and public/images instead.
data_img/

# The superseded static site, kept locally for reference only.
legacy-static/
