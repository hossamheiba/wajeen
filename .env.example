# Copy to .env.local and fill in. .env.local is git-ignored; this file is not,
# so it must never contain a real key.

# Public site origin. Everything SEO-facing is built from this — canonical
# tags, hreflang, Open Graph URLs, sitemap.xml, robots.txt and the JSON-LD
# organisation block. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.wjeen.com

# Resend API key (https://resend.com/api-keys). Server-only: it is deliberately
# NOT prefixed with NEXT_PUBLIC_, so it is never sent to the browser.
MAIL_PROVIDER_API_KEY=re_REPLACE_WITH_YOUR_RESEND_KEY

# Where contact-form submissions are delivered.
MAIL_TO=info@wjeen.com

# Sender address. The domain here must be verified in Resend (SPF + DKIM
# records published) before delivery works outside Resend's own test address.
MAIL_FROM=Wjeen Website <noreply@wjeen.com>
