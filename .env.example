# Copy to .env.local and fill in. .env.local is git-ignored; this file is not,
# so it must never contain a real key.

# Public site origin. Everything SEO-facing is built from this — canonical
# tags, hreflang, Open Graph URLs, sitemap.xml, robots.txt and the JSON-LD
# organisation block. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.wjeen.com

# Resend API key (https://resend.com/api-keys). Server-only: it is deliberately
# NOT prefixed with NEXT_PUBLIC_, so it is never sent to the browser.
MAIL_PROVIDER_API_KEY=re_REPLACE_WITH_YOUR_RESEND_KEY

# Where contact-form submissions are delivered.
MAIL_TO=info@wjeen.com

# Sender address. The domain here must be verified in Resend (SPF + DKIM
# records published) before delivery works outside Resend's own test address.
MAIL_FROM=Wjeen Website <noreply@wjeen.com>

# The shared secret the website's server presents to the CMS when it stores a
# submission. The browser never sees it. Without it the CMS refuses every
# submission, so the contact form stops working rather than accepting writes
# from anywhere.
WJEEN_INQUIRY_TOKEN=replace-with-a-long-random-string

# Where the CMS lives: storing submissions, the media manifest, the published
# text when WJEEN_CONTENT_SOURCE=cms, and the origin the studio's browser code
# talks to.
#
# THIS ONE IS A BUILD-TIME INPUT. Set it before `next build`, and redeploy to
# change it. That is not a limitation to work around, it is how Next treats a
# NEXT_PUBLIC_ variable, and the measured behaviour is worth knowing exactly:
#
#   set at build     the value is inlined into the browser bundle AND into the
#                    server chunks. Changing the variable at run time moves
#                    nothing on the server.
#   unset at build   server code falls back to a run-time lookup, but the
#                    studio then 404s on purpose (STUDIO_CONFIGURED in
#                    src/lib/studio/api.ts): no CMS, no sign-in screen.
#
# The trap, and the reason this is written down: `next start` re-evaluates
# next.config.ts, so next/image's remotePatterns DO follow the run-time value
# while the code that builds image URLs does not. Change this variable without
# rebuilding and the two disagree — every CMS-served image is refused by the
# optimiser with a 400. So: change it, rebuild, redeploy. Never one without the
# others.
NEXT_PUBLIC_CMS_API_URL=http://localhost:8001

# Where CMS images are served from, when that is not the API's own origin — an
# object store or a CDN. Leave unset when the API host serves /media/ itself.
# Also a build-time input, for the same reason as the variable above, and the
# path under it must stay /media/** or next/image refuses every image.
# NEXT_PUBLIC_CMS_MEDIA_URL=https://media.wjeen.com

# Where the site's *text* comes from.
#
#   json  (default) the messages bundled from src/messages/{locale}.json —
#         the behaviour the site has always had, with no network call at all
#   cms   the CMS's published tree, deep-merged OVER the bundled messages
#
# The bundled files stay in either mode: in `cms` they are the base of the
# merge, so a missing namespace, a timeout or a CMS that is down degrades to
# the text that shipped with the build rather than to a broken page. Drafts are
# never read — only published content.
WJEEN_CONTENT_SOURCE=json

# How long a fetched tree is reused, in seconds. Leave unset in production.
# WJEEN_CONTENT_REVALIDATE=60
