# Wjeen CMS backend -- local development only (Stage 3B is not deployed).
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=wjeen_cms
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Production values (documented, not active) -- the full list is in DEPLOYMENT.md:
#   DJANGO_DEBUG=0
#   DJANGO_SECRET_KEY=<50+ random characters; the process refuses to start without one>
#   DJANGO_ALLOWED_HOSTS=api.wjeen.com
#   CORS_ALLOWED_ORIGINS=https://www.wjeen.com
#   CSRF_TRUSTED_ORIGINS=https://www.wjeen.com
#   DJANGO_SECURE_SSL_REDIRECT=1
#   DJANGO_SECURE_HSTS_SECONDS=31536000
#   DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=1
#   DJANGO_SECURE_PROXY_SSL_HEADER=1      only behind a proxy that overwrites X-Forwarded-Proto
#   TRUST_PROXY_HEADER=1                  same condition, for X-Forwarded-For
#   WJEEN_INQUIRY_TOKEN=<same value the website has>
#   WJEEN_MEDIA_URL=https://api.wjeen.com/media/   or the object store / CDN origin
#   WJEEN_MEDIA_ROOT=/persistent/disk/media
#   WJEEN_PRIVATE_ROOT=/persistent/disk/private   never under anything that is served
#   WJEEN_STATIC_ROOT=/app/staticfiles
#
# Cookie security needs no variable: AUTH_/CSRF_/SESSION_COOKIE_SECURE follow
# DEBUG, and SameSite stays Strict. Leave AUTH_COOKIE_DOMAIN and
# CSRF_COOKIE_DOMAIN UNSET: the cookies are then host-only on api.wjeen.com,
# which is what src/proxy.ts assumes, and the studio reads its CSRF token from
# the /auth/csrf/ response body, not from a cookie, so www never needs to see
# either one. Strict still works because www and api are the same site -- which
# is also why the site must be on wjeen.com and not on *.vercel.app.
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
